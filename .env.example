# ==============================================================================
# SCORM & H5P Authoring Studio — Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port & Host
PORT=4000
HOST=0.0.0.0

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scorm_h5p_studio?schema=public"

# Direct URL for migrations (if using PgBouncer in transaction mode)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scorm_h5p_studio?schema=public"

# CORS Allowed Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:8443,http://localhost:3000"

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Authentication & JWT Secrets (Phase 03.2)
JWT_SECRET="dev-secret-key-scorm-h5p-studio-min32chars-for-safety"
