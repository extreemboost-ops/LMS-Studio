{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format": "oxfmt",
    "server:dev": "node ./node_modules/tsx/dist/cli.mjs server/src/server.ts",
    "server:build": "node ./node_modules/typescript/bin/tsc --project server/tsconfig.json",
    "server:start": "node dist-server/server.js",
    "server:test": "node ./node_modules/tsx/dist/cli.mjs server/tests/run-tests.ts",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:validate": "node ./node_modules/prisma/build/index.js validate",
    "render-build": "npm run db:generate && npm run server:build",
    "render-start": "node ./node_modules/prisma/build/index.js db push --accept-data-loss && node dist-server/server.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.77.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "vite": "^8.1.7"
  }
}
